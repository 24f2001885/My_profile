# ==============================================================================
# Environment Configuration & Production Secrets Template
# NEVER commit the actual .env file or production passwords to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Developer Dashboard Authentication (Production Nginx & Client-Side)
# ------------------------------------------------------------------------------
# Username for Nginx HTTP Basic Auth (used on AWS EC2 VPS)
DASHBOARD_USERNAME=admin

# Password for Nginx HTTP Basic Auth and Developer Console
DASHBOARD_PASSWORD=Abhishek@Dev2026!

# Cryptographic Salt and SHA-256 Hash for Web Crypto Client-Side Gate
# (Generate a new pair in dashboard.html under the 'Security & Keys' tab)
DASHBOARD_SALT=ap_sec_salt_2026
DASHBOARD_HASH=38952231177e0c0326f4228f0cc07f4b5b3711ecc8df2cd327213bfe4af3207f

# ------------------------------------------------------------------------------
# 2. AWS EC2 Student VPS Connection (GitHub Actions Secrets)
# Add these in GitHub -> Repo Settings -> Secrets and variables -> Actions
# ------------------------------------------------------------------------------
AWS_EC2_HOST=abhishek4312.info
AWS_EC2_USER=ubuntu
AWS_SSH_PORT=22
# AWS_EC2_SSH_KEY -> Paste your private SSH key (.pem) directly into GitHub Secrets
